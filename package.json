{
  "name": "inlang-plugin-yaml",
  "version": "4.0.0",
  "description": "YAML resource plugin for inlang — import/export YAML translation files (i18next-style and Ruby on Rails-style)",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "./dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixhaeberle/inlang-plugin-yaml"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node ./build.js",
    "build": "NODE_ENV=production node ./build.js && tsc --project tsconfig.build.json",
    "test": "tsc --noEmit && vitest run",
    "clean": "rm -rf ./dist ./node_modules"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.31.28"
  },
  "devDependencies": {
    "@inlang/sdk": "^2.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.5.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
